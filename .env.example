# Copy this file to .env for local development.
# Never commit real credentials or production secrets.

POSTGRES_DB=finbridge
POSTGRES_USER=finbridge_user
POSTGRES_PASSWORD=change-me-local

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local

# Use a long random value in real environments.
JWT_SECRET=replace-with-a-long-random-secret-at-least-64-characters
JWT_EXPIRATION=86400000
